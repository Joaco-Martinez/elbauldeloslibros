# Copiá este archivo como .env.local y completá los valores. .env.local no se sube al repositorio.

# URL pública del sitio (links de los mails y vuelta desde Mercado Pago). En local: http://localhost:3000
SITE_URL=

# --- Panel de pedidos (/admin) ---------------------------------------------
# Contraseña para entrar al panel. Usá una larga y que no uses en otro lado.
ADMIN_PASSWORD=

# Clave del cron que cancela los pedidos sin pagar a las 24 h (Vercel Cron, ver vercel.json).
# Con esta variable cargada en Vercel, el cron manda solo "Authorization: Bearer <esta clave>".
# Además se revisa solo cuando alguien hace un pedido o abre el panel.
CRON_SECRET=

# --- Mercado Pago -------------------------------------------------------------
# Access Token (developers.mercadopago.com > Tus integraciones > Credenciales). Para probar, el de prueba (TEST-...).
MP_ACCESS_TOKEN=
# Clave secreta de los avisos (Webhooks > Clave secreta). Verifica que los avisos vengan de Mercado Pago.
MP_WEBHOOK_SECRET=

# --- Mails (Gmail) -------------------------------------------------------------
# Sin esto, los mails no salen (solo quedan en el log y en la vista previa del panel).
# Cuenta de Gmail desde la que salen los mails (los clientes ven esta dirección).
GMAIL_USER=
# Contraseña de aplicación (myaccount.google.com/apppasswords, requiere verificación en 2 pasos).
# NO es la contraseña normal de la cuenta.
GMAIL_APP_PASSWORD=
# Nombre que ve el cliente como remitente (opcional).
MAIL_FROM_NAME="El Baul de los Libros"
# A dónde te llega el aviso de cada pedido nuevo (opcional: si queda vacío, a GMAIL_USER).
ORDER_EMAIL=

# --- Guardado de pedidos (Upstash Redis: upstash.com) ----------------------------
# Obligatorio en Vercel u otro hosting sin disco. Sin esto, se guardan en .data/orders.json (solo sirve en local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
